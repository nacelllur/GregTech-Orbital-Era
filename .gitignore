# ============================================
# 格雷科技：星环纪元 (GregTech: Orbital Era)
# .gitignore —— 发布到 GitHub 前的排除清单
# ============================================

# ---------- 存档 & 用户数据（好友不需要，且可能含个人信息） ----------
/saves/
/local/
/fancymenu_data/last_world.fmdata
/fancymenu_data/buddy/
/usercache.json
/usernamecache.json
/launcher_profiles.json

# ---------- 日志 & 崩溃报告 ----------
/logs/
/crash-reports/
*.log
*.crash

# ---------- 开发/逆向调试残留（与整合包无关） ----------
/_inj/
/_gto/
/_hpca/
/_gtna_src/
/_gt753_src/
/_downloads/
/_removed_mods/
/_patch*/

# ---------- 第三方 mod jar（体积 226MB） ----------
# 说明：第三方 mod 不入库，改走 GitHub Releases 附件（见 README「安装指南」）。
# 自研 mod（gtoecore / packcompanion）体积仅 271KB，保留入库以便追踪版本。
/mods/*.jar
!/mods/gtoecore-*.jar
!/mods/packcompanion-*.jar

# ---------- 启动器/游戏本体运行时文件（好友用启动器自动下载） ----------
/assets/
/libraries/
/versions/
/natives/
/*.jar

# ---------- mod 备份/暂存目录（防止旧版本 mod 混入） ----------
/mods_backup_*/
/mods_stash_*/
*.jar.bak_prev
*.bak_prev

# ---------- 本地临时数据 & 密码 ----------
# JEI 按世界存档的书签/搜索历史（个人数据）
/config/jei/world/
/config/resourceful-config-web.json
/fancymenu_data/fancymenu_temp/
/fancymenu_data/browser_*/
/fancymenu_data/video_thumbnails/
/gtceu/prospection_cache/
/authlib-injector.log

# ---------- IDE / 系统文件 ----------
.idea/
.vscode/
*.iml
Thumbs.db
Desktop.ini
.DS_Store
